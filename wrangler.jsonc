{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lensclick",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/*.html"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lensclick-db",
      "database_id": "04856b8a-136e-4a98-84c6-bad702079590",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "lensclick-profile-images"
    }
  ]
}
