{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "lensclick",
  "main": "./src/worker.mjs",
  "compatibility_date": "2026-08-01",
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "invocation_logs": false,
      "head_sampling_rate": 1
    }
  },
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/", "/*.html", "/fotografo/*"]
  },
  "triggers": {
    "crons": ["*/5 * * * *"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "lensclick-db",
      "database_id": "04856b8a-136e-4a98-84c6-bad702079590",
      "migrations_dir": "./migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "PROFILE_IMAGES",
      "bucket_name": "lensclick-profile-images"
    }
  ],
  "images": {
    "binding": "IMAGES"
  },
  "ratelimits": [
    {
      "name": "AUTH_RATE_LIMITER",
      "namespace_id": "1909001",
      "simple": {
        "limit": 10,
        "period": 60
      }
    },
    {
      "name": "SENSITIVE_RATE_LIMITER",
      "namespace_id": "1909002",
      "simple": {
        "limit": 5,
        "period": 60
      }
    },
    {
      "name": "CONTENT_RATE_LIMITER",
      "namespace_id": "1909003",
      "simple": {
        "limit": 20,
        "period": 60
      }
    },
    {
      "name": "ACCOUNT_RATE_LIMITER",
      "namespace_id": "1909004",
      "simple": {
        "limit": 30,
        "period": 60
      }
    }
  ]
}
